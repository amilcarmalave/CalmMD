{
  "version": "0.1.0",
  "description": "Markdown, calmly. A calm Markdown editor with live preview, PDF export and Spaces.",
  "homepage": "https://github.com/OWNER/calmmd",
  "license": "MIT",
  "architecture": {
    "64bit": {
      "url": "https://github.com/OWNER/calmmd/releases/download/v0.1.0/CalmMD_0.1.0_x64-setup.exe#/setup.exe",
      "hash": "REPLACE_WITH_SHA256_FROM_SHA256SUMS"
    },
    "arm64": {
      "url": "https://github.com/OWNER/calmmd/releases/download/v0.1.0/CalmMD_0.1.0_arm64-setup.exe#/setup.exe",
      "hash": "REPLACE_WITH_SHA256_FROM_SHA256SUMS"
    }
  },
  "installer": {
    "script": "Start-Process -Wait -FilePath \"$dir\\setup.exe\" -ArgumentList '/S', \"/D=$dir\\app\""
  },
  "uninstaller": {
    "script": "if (Test-Path \"$dir\\app\\uninstall.exe\") { Start-Process -Wait -FilePath \"$dir\\app\\uninstall.exe\" -ArgumentList '/S' }"
  },
  "bin": "app\\calmmd.exe",
  "shortcuts": [["app\\calmmd.exe", "CalmMD"]],
  "checkver": "github",
  "autoupdate": {
    "architecture": {
      "64bit": { "url": "https://github.com/OWNER/calmmd/releases/download/v$version/CalmMD_$version_x64-setup.exe#/setup.exe" },
      "arm64": { "url": "https://github.com/OWNER/calmmd/releases/download/v$version/CalmMD_$version_arm64-setup.exe#/setup.exe" }
    },
    "hash": { "url": "https://github.com/OWNER/calmmd/releases/download/v$version/SHA256SUMS", "regex": "$sha256\\s+$basename" }
  }
}
