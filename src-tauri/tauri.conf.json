{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CalmMD",
  "version": "1.0.0",
  "identifier": "app.calmmd.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CalmMD",
        "width": 1100,
        "height": 760,
        "minWidth": 480,
        "minHeight": 360,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "assetProtocol": { "enable": true, "scope": ["**"] },
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https: data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://api.github.com; media-src 'self' asset: http://asset.localhost https: blob:; frame-src https://www.youtube-nocookie.com https://player.vimeo.com asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "A calm, beautiful Markdown editor",
    "longDescription": "CalmMD is a calm, open-source Markdown editor with live preview, split view with accurate scroll sync, Spaces, math, diagrams and beautiful PDF export.",
    "publisher": "CalmMD contributors",
    "copyright": "© CalmMD contributors. MIT License.",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd"],
        "name": "Markdown document",
        "description": "Markdown document",
        "mimeType": "text/markdown",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": { "section": "editors" },
      "rpm": { "release": "1" }
    }
  }
}
